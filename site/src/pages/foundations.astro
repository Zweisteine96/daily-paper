---
import katex from 'katex';
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
import { allTopics, kindMeta, modules, totalHours } from '../content/foundations';

const tex = (s: string) => katex.renderToString(s, { throwOnError: false, displayMode: true, strict: 'ignore' });
const moduleById = new Map(modules.map((m) => [m.id, m]));
const searchHref = (q: string) => withBase(`search/?q=${encodeURIComponent(q)}`);
---

<Base title="理论基础" description="从零开始的机器人学理论学习路线：运动学与动力学、最优控制与 MPC、运动规划、强化学习、状态估计" active="foundations">
  <div class="page-head">
    <h1>理论基础</h1>
    <span class="sub">{modules.length} 个模块 · {allTopics.length} 个主题 · 约 {totalHours} 小时</span>
    <span class="grow"></span>
    <div class="progress-box" id="progress-box">
      <span class="lbl">已掌握 <b id="progress-n">0</b>/{allTopics.length}</span>
      <div class="progress"><div class="bar" id="progress-bar" style="width:0%"></div></div>
    </div>
  </div>
  <p class="hint">
    一条给「完全不懂机器人」的人的学习路线：从建模到控制、规划、学习与估计。每个主题给出核心概念、关键公式、
    免费的经典资料（Russ Tedrake 的 Underactuated / Manipulation、CMU 16-745、Berkeley CS285 等）和自测题。
    勾选「已掌握」会保存在本地浏览器里。
  </p>

  <!-- 路线图 -->
  <nav class="roadmap" aria-label="学习路线">
    {modules.map((m, i) => (
      <>
        <a href={`#${m.id}`} class="road-node" data-module={m.id}>
          <span class="emoji">{m.emoji}</span>
          <span class="t">{m.title}</span>
          <span class="n"><span class="done">0</span>/{m.topics.length}</span>
        </a>
        {i < modules.length - 1 && <span class="road-arrow">→</span>}
      </>
    ))}
  </nav>

  <div class="found-layout">
    <aside class="toc" id="toc">
      {modules.map((m) => (
        <div class="toc-mod">
          <a href={`#${m.id}`}>{m.emoji} {m.title}</a>
          <ul>
            {m.topics.map((t) => (
              <li><a href={`#${t.id}`} data-topic={t.id}><span class="tick">✓</span>{t.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <div class="found-main">
      {modules.map((m) => (
        <section class="module" id={m.id}>
          <div class="module-head">
            <span class="emoji">{m.emoji}</span>
            <div>
              <h2>{m.title} <span class="en">{m.en}</span></h2>
              <p class="intro">{m.intro}</p>
              {m.prereq && m.prereq.length > 0 && (
                <p class="prereq">
                  先修：{m.prereq.map((p) => <a href={`#${p}`}>{moduleById.get(p)?.emoji} {moduleById.get(p)?.title}</a>)}
                </p>
              )}
            </div>
          </div>

          {m.topics.map((t) => (
            <article class="topic" id={t.id} data-topic={t.id}>
              <header class="topic-head">
                <label class="done-toggle" title="标记为已掌握">
                  <input type="checkbox" data-topic-check={t.id} />
                  <span class="box"></span>
                  <span class="txt">已掌握</span>
                </label>
                <h3>{t.title} <span class="en">{t.en}</span></h3>
                <span class="hours">⏱ 约 {t.hours} 小时</span>
              </header>
              <p class="summary">{t.summary}</p>

              <div class="topic-grid">
                <div>
                  <h4>核心要点</h4>
                  <ul class="points">{t.points.map((p) => <li>{p}</li>)}</ul>

                  {t.formulas && t.formulas.length > 0 && (
                    <>
                      <h4>关键公式</h4>
                      <div class="formulas">
                        {t.formulas.map((f) => (
                          <figure class="formula">
                            <Fragment set:html={tex(f.latex)} />
                            <figcaption>{f.caption}</figcaption>
                          </figure>
                        ))}
                      </div>
                    </>
                  )}

                  {t.quiz && t.quiz.length > 0 && (
                    <details class="quiz">
                      <summary>自测：学完应该能回答</summary>
                      <ol>{t.quiz.map((q) => <li>{q}</li>)}</ol>
                    </details>
                  )}
                </div>

                <div>
                  <h4>推荐资料（全部免费）</h4>
                  <ul class="resources">
                    {t.resources.map((r) => (
                      <li class={r.primary ? 'primary' : ''}>
                        <span class="kind" title={kindMeta[r.kind].label}>{kindMeta[r.kind].icon}</span>
                        <div class="res-body">
                          <a href={r.url} target="_blank" rel="noopener">{r.title}</a>
                          {r.primary && <span class="badge track">首选</span>}
                          <div class="by">{r.by}</div>
                          {r.note && <div class="note">{r.note}</div>}
                        </div>
                      </li>
                    ))}
                  </ul>
                  {t.papers && t.papers.length > 0 && (
                    <p class="related">
                      在本站找相关新论文：
                      {t.papers.map((k) => <a class="chip kw" href={searchHref(k)}>{k}</a>)}
                    </p>
                  )}
                </div>
              </div>
            </article>
          ))}
        </section>
      ))}

      <section class="module" id="how-to">
        <div class="module-head">
          <span class="emoji">🧭</span>
          <div>
            <h2>怎么走这条路 <span class="en">How to Use This Page</span></h2>
            <ul class="points intro-list">
              <li><b>顺序：</b>数学准备只需先过一遍线性代数与优化，其余在用到时回头补。建模 → 控制是主干；规划、学习、估计三条支线可以按兴趣并行。</li>
              <li><b>动手：</b>每个模块至少复现一个例子——用 MuJoCo / Pinocchio 验证推出的动力学；用 CasADi 写一个倒立摆的直接配点；用 legged_gym 训练一个四足策略；用 Labbe 的 notebook 跑一遍 EKF。</li>
              <li><b>两条主线：</b>Russ Tedrake 的 <a href="https://underactuated.mit.edu/" target="_blank" rel="noopener">Underactuated Robotics</a> 与 CMU 的 <a href="https://optimalcontrol.ri.cmu.edu/" target="_blank" rel="noopener">16-745</a> 覆盖了建模到 MPC 的绝大部分内容；Berkeley 的 <a href="https://rail.eecs.berkeley.edu/deeprlcourse/" target="_blank" rel="noopener">CS285</a> 与 Barfoot 的 <a href="http://asrl.utias.utoronto.ca/~tdb/bib/barfoot_ser17.pdf" target="_blank" rel="noopener">State Estimation for Robotics</a> 分别是学习与估计的主线。</li>
              <li><b>与每日推荐联动：</b>每个主题末尾的关键词可以直接跳到搜索页，看看这个方向今天有什么新论文。</li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    const KEY = 'ts:foundations:v1';
    type Progress = Record<string, string>;
    const load = (): Progress => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || '{}');
      } catch {
        return {};
      }
    };
    const save = (p: Progress) => localStorage.setItem(KEY, JSON.stringify(p));

    const checks = Array.from(document.querySelectorAll<HTMLInputElement>('input[data-topic-check]'));
    const total = checks.length;

    function refresh() {
      const p = load();
      let n = 0;
      const perModule = new Map<string, number>();
      for (const c of checks) {
        const id = c.dataset.topicCheck!;
        const done = Boolean(p[id]);
        c.checked = done;
        const art = c.closest<HTMLElement>('.topic');
        art?.classList.toggle('is-done', done);
        document.querySelector(`#toc a[data-topic="${id}"]`)?.classList.toggle('done', done);
        if (done) {
          n++;
          const mod = art?.closest<HTMLElement>('.module')?.id;
          if (mod) perModule.set(mod, (perModule.get(mod) ?? 0) + 1);
        }
      }
      document.getElementById('progress-n')!.textContent = String(n);
      (document.getElementById('progress-bar') as HTMLElement).style.width = `${total ? (100 * n) / total : 0}%`;
      document.querySelectorAll<HTMLElement>('.road-node').forEach((node) => {
        const m = node.dataset.module!;
        const done = perModule.get(m) ?? 0;
        node.querySelector('.done')!.textContent = String(done);
        const all = Number(node.querySelector('.n')!.textContent!.split('/')[1]);
        node.classList.toggle('complete', done === all);
      });
    }

    for (const c of checks) {
      c.addEventListener('change', () => {
        const p = load();
        const id = c.dataset.topicCheck!;
        if (c.checked) p[id] = new Date().toISOString();
        else delete p[id];
        save(p);
        refresh();
      });
    }
    refresh();

    // 滚动时高亮目录
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#toc a[data-topic]'));
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).dataset.topic;
          links.forEach((l) => l.classList.toggle('active', l.dataset.topic === id));
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    document.querySelectorAll<HTMLElement>('.topic[data-topic]').forEach((el) => obs.observe(el));
  </script>
</Base>
