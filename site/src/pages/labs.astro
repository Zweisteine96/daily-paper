---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { labPaperToCard, labsData } from '../lib/data';

const labs = labsData?.labs ?? [];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-');
---

<Base title="学者追踪" active="labs">
  <div class="page-head">
    <h1>学者追踪</h1>
    {labsData && (
      <span class="sub">最近 {labsData.days_back} 天 · 共 {labsData.total} 篇 · 更新于 {labsData.updated.slice(0, 10)}</span>
    )}
  </div>
  <p class="hint">
    追踪名单在 <code>profile/labs.yaml</code> 里维护，按 arXiv 署名精确匹配并限制在相关分类，下一次运行生效。
    每日推荐里命中这些学者的论文会带有「追踪学者」徽标并略微加分。
  </p>

  {labs.length === 0 ? (
    <div class="empty">还没有数据。运行一次管道后这里会出现各实验室的近期论文。</div>
  ) : (
    <>
      <nav class="lab-nav">
        {labs.map((lab) => (
          <a href={`#${slug(lab.short)}`}>{lab.short}<span class="n">{lab.total}</span></a>
        ))}
      </nav>

      {labs.map((lab) => (
        <section class="lab" id={slug(lab.short)}>
          <h2>{lab.name}</h2>
          <p class="hint" style="margin-top:0">{lab.researchers.map((r) => r.name).join(' · ')}</p>
          {lab.researchers.map((r) => (
            <div class="researcher">
              <h3>
                {r.name}
                <span class="n">{r.papers.length} 篇</span>
              </h3>
              {r.papers.length === 0 ? (
                <p class="empty-line">窗口期内没有新论文</p>
              ) : (
                <div class="cards">
                  {r.papers.map((p) => <Card item={labPaperToCard(p, r.name)} compact />)}
                </div>
              )}
            </div>
          ))}
        </section>
      ))}
    </>
  )}
</Base>
